# Copy to .env for local Docker Compose: cp .env.example .env
# LOCAL DEVELOPMENT ONLY — rotate all values before any shared or network-exposed deployment.

SWIFTEATS_ALLOW_INSECURE_DEFAULTS=true

ADMIN_API_KEY=local-dev-admin-key-change-me
INTERNAL_SERVICE_API_KEY=local-dev-internal-key-change-me

# Demo customer (seed V5/V7) — used with header X-Customer-Id
CUSTOMER_ID=44444444-4444-4444-4444-444444444401
CUSTOMER_API_TOKEN=demo-customer-token-local-only

# Demo driver (seed V6/V7/V12) — used with POST /drivers/{driverId}/location
DRIVER_ID=55555555-5555-5555-5555-555555555501
DRIVER_API_TOKEN=demo-driver-token-001

# GPS simulator (docker-compose backend-service defaults: 50 drivers, 5s interval ≈ 10 evt/s)
# GPS_SIMULATOR_ENABLED=true
# GPS_SIMULATOR_DRIVER_COUNT=50
# GPS_SIMULATOR_INTERVAL_MS=5000
