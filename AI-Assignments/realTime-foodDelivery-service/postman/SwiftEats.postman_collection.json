              { "key": "X-Customer-Id", "value": "{{customerId}}" },
              { "key": "X-Customer-Api-Key", "value": "{{customerApiToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurantId\": \"{{restaurantId}}\",\n  \"deliveryAddress\": \"123 MG Road, Pune\",\n  \"city\": \"Pune\",\n  \"paymentMode\": \"UPI\",\n  \"items\": [{ \"menuItemId\": \"{{menuItemId}}\", \"quantity\": 1 }]\n}"
            },
            "url": "{{baseUrl}}/api/v1/orders"
          }
