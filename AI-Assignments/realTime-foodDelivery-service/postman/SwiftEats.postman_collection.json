            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}/tracking/stream"
          }
        },
        {
          "name": "Post driver location",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Driver-Api-Key", "value": "{{driverApiToken}}" }
            ],
