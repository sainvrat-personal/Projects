              "mode": "raw",
              "raw": "{\n  \"latitude\": 18.5210,\n  \"longitude\": 73.8570,\n  \"heading\": 90,\n  \"orderId\": \"{{orderId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/drivers/{{driverId}}/location"
          }
        }
      ]
    },
